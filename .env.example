# Site URL used for sitemap, Open Graph, and robots.txt.
# Production custom domain.
NEXT_PUBLIC_SITE_URL=https://mardeinc.com

# Replace with MARDE's existing live Stripe donation URL before deploying.
NEXT_PUBLIC_STRIPE_DONATION_URL=https://donate.stripe.com/8x214f7jVbKXdHWakm6kg00

# Leave empty for the mardeinc.com deployment.
NEXT_PUBLIC_BASE_PATH=

# Optional analytics. Leave empty to render no GA4 script.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional Google Search Console HTML metadata verification value.
GOOGLE_SITE_VERIFICATION=
