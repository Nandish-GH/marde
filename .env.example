# Site URL used for sitemap, Open Graph, and robots.txt.
# Production custom domain.
NEXT_PUBLIC_SITE_URL=https://mardeinc.com

# Replace with MARDE's existing live Stripe donation URL before deploying.
NEXT_PUBLIC_STRIPE_DONATION_URL=https://donate.stripe.com/8x214f7jVbKXdHWakm6kg00

# Optional: add a Plausible domain to enable lightweight analytics.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=mardeinc.com

# Optional: Formspree form IDs for contact and newsletter signup.
# Create forms at https://formspree.io and paste the form ID (the part after /f/).
NEXT_PUBLIC_FORMSPREE_CONTACT=
NEXT_PUBLIC_FORMSPREE_NEWSLETTER=

# Leave empty for the mardeinc.com deployment.
NEXT_PUBLIC_BASE_PATH=
