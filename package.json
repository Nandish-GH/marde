{
  "name": "marde-site",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/finalize-export.mjs && node scripts/generate-agent-content.mjs",
    "start": "next start",
    "lint": "eslint .",
    "qa:capture": "node scripts/capture-qa.mjs",
    "test:browser": "playwright test",
    "test:agent": "node --test tests/agent/*.test.mjs",
    "verify:export": "node scripts/verify-agent-export.mjs",
    "verify:public": "node scripts/verify-public.mjs && node scripts/verify-brand.mjs",
    "worker:check": "wrangler deploy --dry-run"
  },
  "dependencies": {
    "@formspree/react": "^3.0.0",
    "@next/third-parties": "^16.3.4",
    "@phosphor-icons/react": "^2.1.10",
    "animejs": "^4.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lenis": "1.3.26",
    "next": "^16.3.8",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "cheerio": "^1.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "tailwindcss": "^4.3.3",
    "turndown": "^7.2.4",
    "typescript": "^6.0.3",
    "wrangler": "^4.146.0"
  }
}
